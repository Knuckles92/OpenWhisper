# Logs and diagnostics
*.log
*.log.*
# Runtime diagnostic samples/failure journal (services/diagnostics.py writes
# these next to the log in the data root; local-only input to the opt-in
# support report, regenerated on every run — never commit them)
diagnostic-metrics.json
diagnostic-metrics.tmp
diagnostic-failures.json
diagnostic-failures.tmp

# Audio artifacts
*.wav
*.mp3
# Crash-recovery journal written next to the output file (services/recording_journal.py)
.*-recovery/
recordings/
meeting_audio/
meeting_recordings/
# Meeting Mode spool root (config.MEETINGS_FOLDER)
meetings/
# Walkthroughs and annotated screenshots (services/walkthrough/storage.py)
/captures/
# Downloaded corpora and generated dogfood benchmark outputs.
benchmarks/meeting_mode/data/
benchmarks/meeting_mode/results/
# Raw TypeSafe benchmark runs stay local.
benchmarks/typesafe_results/*
benchmarks/typesafe_human_labels/results/*
!benchmarks/typesafe_human_labels/results/summary.json
# Local meeting-mode dogfood/eval workspace (audio, ffmpeg, DBs — can exceed GitHub limits).
tmp_meeting_eval/

# Local data and settings (auto-generated at runtime)
/:memory:.ses
openwhisper_settings.json
openwhisper.db
.openwhisper-data.lock
# WAL journaling (enabled for Meeting Mode) keeps two sidecar files alongside it
openwhisper.db-wal
openwhisper.db-shm
# Remote engine host identity (its private key must never be committed)
remote_engine_host_cert.pem
remote_engine_host_key.pem
transcription_history.json
transcription_history.json.bak
meetings.json
meetings.json.bak
# MCP event subscriptions and the Scratchpad's autosaved text (data root)
mcp_event_subscriptions.json
scratchpad.txt

# Environment files
*.env
!.env.example

# Virtual environments
venv/
**/venv/
.venv/
venv312/
wsl_venv/
node_modules/

# Python build/test caches
**/__pycache__/
*__pycache__*
.pytest_cache/
*.spec
# ...but the packaging spec is source, not build output.
!OpenWhisper.spec
!OpenWhisperUpdater.spec

# PyInstaller / Inno Setup build output
/build/
/dist/
/installer/Output/
/.tmp/

# Pi sidecar bundle: a ~15 MB build artifact rebuilt by `node sidecar/build.mjs`
# and shipped inside the meeting-agent component archive, never read from the
# repo at runtime. (webui/dist IS committed — OpenWhisper.spec bundles it.)
sidecar/dist/
sidecar-opencode/dist/

# Editor / tool state
.DS_Store
.claude/settings.local.json
.claude/settings.local.json.bak
.claude/launch.json
.vscode/settings.json
.cursor/worktrees.json
.pi/
.piview/
.codex/
.zcode/
.shots/
.grok/

# Design mockups (local planning artifacts, not shipped)
mockups/
webui/mocks/
docs/design/settings-basic-advanced-v1/
docs/design/settings-simplification-v2/
# Marketing drafts and their reference images (third-party wallpapers included)
docs/marketing/

# Agent instruction files (kept local by preference)
CLAUDE.md
AGENTS.md
docs/screenshots/full_suite/*
specs/local-asr-backends-plan.md

# Local diagnostic captures, renders, ad cuts and other scratch media.
# Anything made for one-off use goes in artifacts/<name>/, never the repo root.
/artifacts/
# Stray renders and screenshots dropped at the repo root. Media the repo ships
# lives in demo/, docs/ or ui_qt/assets/ and is added deliberately.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mp4
/*.webm
/*.mov
/*.mkv
