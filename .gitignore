meetings/
# Downloaded corpora and generated dogfood benchmark outputs.
benchmarks/meeting_mode/data/
benchmarks/meeting_mode/results/
# Local meeting-mode dogfood/eval workspace (audio, ffmpeg, DBs — can exceed GitHub limits).
tmp_meeting_eval/

# Local data and settings (auto-generated at runtime)
openwhisper_settings.json
openwhisper.db
# WAL journaling (enabled for Meeting Mode) keeps two sidecar files alongside it
openwhisper.db-wal
openwhisper.db-shm
transcription_history.json
transcription_history.json.bak
meetings.json
meetings.json.bak

# Environment files
*.env
!.env.example

# Virtual environments
venv/
**/venv/
.venv/
venv312/
wsl_venv/
node_modules/

# Python build/test caches
**/__pycache__/
*__pycache__*
.pytest_cache/
*.spec
# ...but the packaging spec is source, not build output.
!OpenWhisper.spec

# PyInstaller / Inno Setup build output
/build/
/dist/
/installer/Output/

# Pi sidecar bundle: a ~15 MB build artifact rebuilt by `node sidecar/build.mjs`
# and shipped inside the meeting-agent component archive, never read from the
# repo at runtime. (webui/dist IS committed — OpenWhisper.spec bundles it.)
sidecar/dist/

