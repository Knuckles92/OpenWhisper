# Copy this file to `.env` in the repo root and fill in the keys you need.
# Packaged builds look in the per-user OpenWhisper data directory first.
# `.env` is gitignored. Local transcription works without any of these.

# OpenAI — cloud transcription (Whisper / GPT-4o) and OpenAI-backed
# transcript cleanup / meeting intelligence.
OPENAI_API_KEY=

# OpenRouter — transcript cleanup and meeting-mode agent.
OPENROUTER_API_KEY=

# Custom OpenAI-compatible endpoints (added in Model Manager) reference
# their own environment variable by name. Example:
# LMSTUDIO_API_KEY=
# Leave that variable blank in the profile for an auth-free local server.

# Logging. Default is INFO. DEBUG / WARNING / ERROR also work.
# OPENWHISPER_LOG_LEVEL=INFO

# Hard override: disable all Hugging Face model downloads (scripts / CI).
# The in-app Settings → Advanced download policy is usually enough.
# HF_HUB_OFFLINE=1
