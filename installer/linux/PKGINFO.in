pkgname = openwhisper
pkgbase = openwhisper
pkgver = @VERSION@-1
pkgdesc = Private, local-first speech-to-text desktop application
url = https://openwhisper.fiorilabs.tech
builddate = @BUILDDATE@
packager = Fiori Labs <support@fiorilabs.tech>
size = @INSTALLED_SIZE_BYTES@
arch = x86_64
license = MIT
depend = glibc>=@GLIBC_MIN@
depend = libdrm
depend = libegl
depend = libgl
depend = portaudio
depend = wayland
depend = xcb-util-cursor
depend = xcb-util-wm
depend = xcb-util-keysyms
depend = libxcb
depend = libxkbcommon
optdepend = gnome-keyring: Secret Service credential storage for API keys
