 "questions": [
  {
   "id": "q_350bfe7122be",
   "text": "Beyond pitch, which features are needed to reliably model a person's identity from the separated signal?",
   "status": "open",
   "suggested_answer": "The vocal tract (mouth/nose) transformation, which is almost unique per person, plus voice dynamics and rate of speech \u2014 though rate of speech varies over time.",
