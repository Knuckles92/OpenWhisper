     "sg_9c782b41a3933c7b2c00",
     "sg_b4af496edbcfc74b1e52"
    ],
    "created_at": "2026-08-15T23:57:17.146917",
    "updated_at": "2026-08-15T23:57:17.146917"
   },
   {
    "id": "it_d7237f29fbbd",
    "card": "live_notes",
    "text": "Clustering the different locations over time yields small clusters of speech; this matters because in spontaneous speech the words are quite small, so the clustering needs to be done adequately. Other ways exist, but this approach was recommended.",
    "data": {
     "heading": "Clustering locations over time",
     "start_s": 924.4
    },
    "status": "proposed",
    "author_type": "agent",
    "author_id": "agent",
    "pinned": false,
    "revision": 1,
    "evidence": [
