    ],
    "created_at": "2026-08-15T23:57:17.146917",
    "updated_at": "2026-08-15T23:57:17.146917"
   },
   {
    "id": "it_1ad1c3328a5e",
    "card": "live_notes",
    "text": "Asked whether speaking one word every second would be detected as a single event; the detected event would be a sum of small parts, and very small intervals should be considered one intervention. The first prototype focuses on quantity of speech, but details like someone saying \"yes yes yes\" from time to time show participation, unlike someone replying without moving.",
    "data": {
     "heading": "Event granularity: small interventions",
     "start_s": 961.3
    },
    "status": "proposed",
