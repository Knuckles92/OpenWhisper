/* Modern PyQt6 Theme Stylesheet - Apple-like Redesign */
/* Dark mode with soft grays, blurred backgrounds, and vibrant accents */

/* Main color palette */
QMainWindow {
    background-color: #1c1c1e; /* Apple Dark Mode Background */
    color: #f5f5f7; /* Apple Text White */
}

QWidget {
    background-color: #1c1c1e;
    color: #f5f5f7;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px; /* Increased base font size */
}

/* Top-level dialogs */
QDialog {
    background-color: #1c1c1e;
    color: #f5f5f7;
}

/* Standard buttons with modern styling */
QPushButton {
    background-color: #2c2c2e; /* Secondary System Fill */
    color: #0a84ff; /* Apple System Blue */
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 14px;
    outline: none;
}

QPushButton:hover {
    background-color: #3a3a3c;
}

QPushButton:pressed {
    background-color: #1c1c1e;
    color: #007aff; /* Darker Blue */
}

QPushButton:disabled {
    color: #636366; /* Label Color Secondary */
    background-color: #2c2c2e;
}

/* Primary action buttons (more prominent) */
QPushButton#primaryButton {
    background-color: #0a84ff;
    color: #ffffff;
    font-size: 15px;
    padding: 12px 24px;
}

QPushButton#primaryButton:hover {
    background-color: #007aff;
}

QPushButton#primaryButton:pressed {
    background-color: #0062cc;
}

/* Danger buttons (for cancel/stop) */
QPushButton#dangerButton {
    background-color: #ff453a; /* Apple System Red */
    color: #ffffff;
}

QPushButton#dangerButton:hover {
    background-color: #ff3b30;
}

QPushButton#dangerButton:pressed {
    background-color: #d70015;
}

/* Success buttons */
QPushButton#successButton {
    background-color: #30d158; /* Apple System Green */
    color: #ffffff;
}

QPushButton#successButton:hover {
    background-color: #28cd41;
}

QPushButton#successButton:pressed {
    background-color: #1fb34a;
}

/* Warning buttons (yellow/amber) */
QPushButton#warningButton {
    background-color: #ff9f0a; /* Apple System Orange */
    color: #ffffff;
}

QPushButton#warningButton:hover {
    background-color: #ff9500;
}

QPushButton#warningButton:pressed {
    background-color: #cc7700;
}

QPushButton#successButton[inactive="true"],
QPushButton#successButton[inactive="true"]:hover,
QPushButton#successButton[inactive="true"]:pressed {
    background-color: rgba(48, 209, 88, 0.28);
    color: rgba(255, 255, 255, 0.55);
}

QPushButton#dangerButton[inactive="true"],
QPushButton#dangerButton[inactive="true"]:hover,
QPushButton#dangerButton[inactive="true"]:pressed {
    background-color: rgba(255, 69, 58, 0.28);
    color: rgba(255, 255, 255, 0.55);
}

QPushButton#warningButton[inactive="true"],
QPushButton#warningButton[inactive="true"]:hover,
QPushButton#warningButton[inactive="true"]:pressed {
    background-color: rgba(255, 159, 10, 0.28);
    color: rgba(255, 255, 255, 0.55);
}

/* ComboBox (Model selector) */
QComboBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 24px;
}

QComboBox::down-arrow {
    image: none; /* TODO: Add SVG icon if possible, or use character */
    border-left: 2px solid #8e8e93;
    border-bottom: 2px solid #8e8e93;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    /* Note: CSS transform is not supported in QSS */
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #f5f5f7;
    selection-background-color: #0a84ff;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

/* Label styling */
QLabel {
    color: #f5f5f7;
    font-size: 14px;
}

QLabel#headerLabel {
    color: #ffffff;
    font-weight: 700;
    font-size: 18px; /* Larger headers */
    background-color: transparent;
}

QLabel#statusLabel {
    color: #8e8e93; /* Secondary Label Color */
    font-size: 13px;
}

QLabel#accentLabel {
    color: #0a84ff;
    font-weight: 600;
}

/* Section headings inside dialogs and panels */
QLabel#sectionLabel {
    color: #8e8e93;
    font-weight: 600;
    font-size: 13px;
}

/* Small hint/help text under controls */
QLabel#infoLabel {
    color: #8e8e93;
    font-size: 12px;
    background-color: transparent;
}

/* Text input fields */
QLineEdit {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QLineEdit:focus {
    border: 1px solid #0a84ff;
}

/* Model Manager — rail and stack; Downloads shares the same surfaces */
QDialog#modelManagerDialog,
QDialog#downloadsDialog,
QDialog#settingsDialog,
QDialog#componentDetailsDialog {
    background-color: #10161c;
}

QWidget#modelManagerBody,
QWidget#modelManagerStack {
    background-color: transparent;
}

/* Let the page surface show through the scroll area, its viewport, and the
   scrolled content (the three-level selector Qt needs for the latter two).
   Otherwise the default widget grey frames every card in a lighter inset. */
#downloadsDialog QScrollArea,
#downloadsDialog QScrollArea > QWidget,
#downloadsDialog QScrollArea > QWidget > QWidget,
QScrollArea#transcriptionTabScrollArea,
QScrollArea#transcriptionTabScrollArea > QWidget,
QScrollArea#transcriptionTabScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* The rail sits a shade darker than the body, so the page reads as the
   working surface and the rail as chrome. */
QWidget#modelManagerRailPane {
    background-color: #0c1116;
    border-right: 1px solid #232d36;
}

QLabel#modelManagerRailBrand {
    color: #eaeff4;
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: 700;
}

QListWidget#modelManagerRail {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px 11px;
}

/* Item widgets paint the selection, so the view's own item states must not. */
QListWidget#modelManagerRail::item,
QListWidget#modelManagerRail::item:selected,
QListWidget#modelManagerRail::item:hover {
    background: transparent;
    border: none;
}

QLabel#modelManagerRailGroup {
    color: #6b7885;
    background-color: transparent;
    border: none;
    font-size: 10px;
    font-weight: 700;
}

QWidget#modelManagerRailItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
}

QWidget#modelManagerRailItem:hover {
    background-color: #141d26;
    border-color: #263240;
}

QWidget#modelManagerRailItem[selected="true"] {
    background-color: #172b45;
    border-color: #318dff;
}

QLabel#modelManagerRailIcon {
    background-color: transparent;
    border: none;
}

QLabel#modelManagerRailName {
    color: #c3ccd6;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 600;
}

QLabel#modelManagerRailName[selected="true"] {
    color: #edf6ff;
}

QLabel#modelManagerRailValue {
    color: #79858f;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QLabel#modelManagerRailValue[selected="true"] {
    color: #8fc2ff;
}

QLabel#modelManagerRailFootnote {
    color: #6b7885;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QPushButton#modelManagerDownloadsButton {
    color: #cfd8e2;
    background-color: #151d25;
    border: 1px solid #3b4752;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#modelManagerDownloadsButton:hover {
    color: #f2f5f8;
    background-color: #1c2731;
    border-color: #52606d;
}

QLabel#localModelPickerCaption {
    color: #98a3b0;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QComboBox#localModelPickerCombo,
QComboBox#ondemandEngineCombo,
QComboBox#meetingLanguageCombo,
QComboBox#meetingSpeakerIdCombo,
QComboBox#meetingAgentCoreCombo,
QComboBox#libraryDeviceCombo,
QComboBox#libraryComputeCombo {
    color: #eef2f6;
    background-color: #161e26;
    border: 1px solid #3b4752;
    border-radius: 9px;
    font-size: 13px;
    padding-left: 12px;
    padding-right: 32px;
}

QPushButton#localModelPickerManage {
    color: #0a84ff;
    background: transparent;
    border: none;
    font-size: 12px;
    padding: 2px 4px;
}

QPushButton#localModelPickerManage:hover {
    text-decoration: underline;
}

QLabel#modelRowUsage {
    background-color: rgba(10, 132, 255, 0.10);
    color: #8eb8ff;
    border: 1px solid rgba(10, 132, 255, 0.22);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

QWidget#textModelPicker {
    background-color: transparent;
}

QLabel#modelManagerHeaderIcon {
    background-color: #121d28;
    border: 1px solid #268cff;
    border-radius: 8px;
    padding: 1px;
}

QLabel#modelManagerTitle {
    color: #f2f5f8;
    font-size: 20px;
    font-weight: 700;
    background-color: transparent;
    border: none;
}

QLabel#modelManagerSubtitle {
    color: #9da8b5;
    font-size: 13px;
    background-color: transparent;
    border: none;
}

QLabel#textProviderUrl {
    color: #7d8b99;
    font-size: 11px;
    font-family: Consolas, "Cascadia Mono", "SF Mono", monospace;
    background-color: transparent;
    border: none;
}

QPushButton#textEndpointAddButton,
QPushButton#textEndpointEditButton,
QPushButton#textEndpointDeleteButton {
    color: #c5ced8;
    background-color: #141b22;
    border: 1px solid #3b4752;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#textEndpointAddButton:hover,
QPushButton#textEndpointEditButton:hover,
QPushButton#textEndpointDeleteButton:hover {
    color: #f2f5f8;
    background-color: #1a232c;
    border-color: #52606d;
}

QPushButton#textEndpointEditButton:disabled,
QPushButton#textEndpointDeleteButton:disabled {
    color: #66707a;
    border-color: #2a333c;
}

QDialog#textEndpointDialog {
    background-color: #12181f;
}

QLabel#textEndpointError {
    color: #ff6b6b;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

QLabel#textModelStatus,
QLabel#textModelFootnote {
    color: #98a3b0;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

QLabel#textProviderCredentialIcon,
QLabel#textModelFootnoteIcon {
    background-color: transparent;
    border: none;
}

QLabel#textProviderRequirement {
    color: #e0a052;
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
}

QLabel#textProviderRequirement[available="true"] {
    color: #30d158;
}

QLabel#apiKeyStatus {
    color: #e0a052;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QLabel#apiKeyStatus[tone="success"] {
    color: #30d158;
}

QLineEdit#apiKeyInput {
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    letter-spacing: 1px;
}

QWidget#modelManagerFieldGroup {
    background-color: transparent;
}

QLabel#textModelFieldLabel {
    color: #9da8b5;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QComboBox#textModelProviderCombo,
QComboBox#textModelSort,
QComboBox#textModelCombo {
    color: #eef2f6;
    background-color: #161e26;
    border: 1px solid #3b4752;
    border-radius: 9px;
    font-size: 14px;
    padding-left: 12px;
    padding-right: 32px;
}

QComboBox#textModelProviderCombo {
    font-weight: 600;
}

QComboBox#textModelProviderCombo:focus,
QComboBox#textModelSort:focus,
QComboBox#textModelCombo:focus {
    border-color: #0a84ff;
}

/* Every combo in these two windows. The global fallback draws its arrow from
   two borders, which reads as a stray corner mark beside a real chevron. */
QDialog#modelManagerDialog QComboBox::down-arrow,
QDialog#downloadsDialog QComboBox::down-arrow,
QDialog#settingsDialog QComboBox::down-arrow {
    image: url(ui_qt/assets/tabler/chevron-down-slate.svg);
    border: none;
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

QFrame#textModelGroupSeparator {
    background-color: transparent;
    border: none;
    border-top: 1px solid #232d36;
}

QPushButton#textModelRefreshButton {
    color: #4aa0ff;
    background-color: #141b22;
    border: 1px solid #318dff;
    border-radius: 9px;
    padding: 6px 12px;
}

QPushButton#textModelRefreshButton:hover {
    color: #83bdff;
    background-color: #172538;
    border-color: #62aaff;
}

QFrame#textModelFootnoteCard {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 10px;
}

QLabel#modelManagerMessage {
    color: #8e99a6;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QPushButton#modelManagerCloseButton {
    color: #aeb8c3;
    background-color: #151c23;
    border: 1px solid #35404a;
    border-radius: 9px;
    font-size: 13px;
}

QPushButton#modelManagerCloseButton:hover {
    color: #f0f3f6;
    background-color: #1b252e;
    border-color: #4b5966;
}

QLineEdit#modelManagerSearch,
QComboBox#modelManagerSort,
QComboBox#modelManagerStatusFilter {
    min-height: 32px;
    max-height: 32px;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
}

QComboBox#modelManagerSort {
    min-width: 160px;
    padding-right: 28px;
}

QComboBox#modelManagerStatusFilter {
    min-width: 140px;
    padding-right: 28px;
}

QLabel#downloadsEnvBanner {
    color: #ff9f0a;
    background-color: rgba(255, 159, 10, 0.1);
    border: 1px solid rgba(255, 159, 10, 0.35);
    border-radius: 8px;
    padding: 8px 12px;
}

/* Downloads window — catalog list plus the model profile inspector that
   replaced the separate Model Details dialog. */
QLabel#downloadsTitle {
    color: #f2f5f8;
    background-color: transparent;
    border: none;
    font-size: 20px;
    font-weight: 700;
}

QLabel#downloadsSubtitle,
QLabel#downloadsMessage {
    color: #8e99a6;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QFrame#downloadsInspector {
    background-color: #141b22;
    border: 1px solid #35404a;
    border-radius: 12px;
}

QLabel#downloadsEyebrow {
    color: #6b7885;
    background-color: transparent;
    border: none;
    font-size: 10px;
    font-weight: 700;
}

QLabel#downloadsInspectorName {
    color: #f1f4f7;
    background-color: transparent;
    border: none;
    font-size: 18px;
    font-weight: 700;
}

QLabel#downloadsInspectorTags,
QLabel#downloadsInspectorUsage {
    color: #6fb1ff;
    background-color: rgba(10, 132, 255, 0.12);
    border: 1px solid rgba(10, 132, 255, 0.25);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#downloadsSectionTitle {
    color: #f0f3f6;
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: 700;
}

QLabel#downloadsInspectorBody,
QLabel#downloadsFactValue {
    color: #b7c0cb;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QLabel#downloadsFactLabel {
    color: #7b8794;
    background-color: transparent;
    border: none;
    font-size: 10px;
    font-weight: 600;
}

QLabel#downloadsSourceNote {
    color: #67717c;
    background-color: transparent;
    border: none;
    font-size: 10px;
}

QPushButton#downloadsRepoButton,
QPushButton#downloadsOriginButton,
QPushButton#downloadsCloseButton {
    color: #aeb8c3;
    background-color: #151c23;
    border: 1px solid #35404a;
    border-radius: 8px;
    font-size: 12px;
}

QPushButton#downloadsRepoButton:hover,
QPushButton#downloadsOriginButton:hover,
QPushButton#downloadsCloseButton:hover {
    color: #f0f3f6;
    background-color: #1b252e;
    border-color: #4b5966;
}

QFrame#downloadsComponentStrip {
    background-color: transparent;
    border: none;
    border-top: 1px solid #232d36;
}

/* Batch selection in the Downloads window: flat link actions, running
   total, and the multi-model confirmation. */
QPushButton#downloadsFlatButton {
    color: #6fb1ff;
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 4px;
}

QPushButton#downloadsFlatButton:hover {
    color: #8ec2ff;
}

QPushButton#downloadsFlatButton:disabled {
    color: #636366;
}

QLabel#downloadsSelectionSummary {
    color: #8e99a6;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QLabel#batchModelList {
    color: #b7c0cb;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QLabel#batchTotalLabel {
    color: #f0f3f6;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 700;
}

QLabel#batchDestPath {
    color: #aeb8c3;
    background-color: #151c23;
    border: 1px solid #35404a;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11px;
}

/* Settings > General: one rounded tile per on/off setting. The tile, not
   just the indicator, is the click target, so hover and the checked tint tell
   the user the whole card reacts. */
QLabel#settingsTileGroupTitle {
    color: #8d9aa7;
    background-color: transparent;
    border: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-top: 2px;
}

QFrame#settingsTile {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 12px;
}

QFrame#settingsTile:hover {
    background-color: #182028;
    border-color: #3d4a57;
}

QFrame#settingsTile[checked="true"] {
    background-color: #142130;
    border-color: #2a5382;
}

QFrame#settingsTile[checked="true"]:hover {
    background-color: #17263a;
    border-color: #3a6aa3;
}

/* Value tiles are not click targets, so they keep the resting colors. */
QFrame#settingsTile[kind="field"]:hover {
    background-color: #141b22;
    border-color: #303b45;
}

QWidget#settingsTileBody {
    background-color: transparent;
}

QLabel#settingsTileFieldLabel {
    color: #c7d0d9;
    background-color: transparent;
    border: none;
    font-size: 13px;
}

QFrame#settingsTile QLabel#settingsTileGroupTitle,
QFrame#settingsTile QLabel#infoLabel {
    padding-top: 0;
}

QFrame#settingsTile:disabled {
    background-color: #12181e;
    border-color: #263038;
}

QLabel#settingsTileIcon {
    background-color: transparent;
    border: none;
}

QLabel#settingsTileTitle {
    color: #e8edf2;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 600;
}

QLabel#settingsTileDescription {
    color: #98a3b0;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QLabel#settingsTileTitle:disabled,
QLabel#settingsTileDescription:disabled {
    color: #5d6873;
}

QFrame#settingsTile QCheckBox::indicator:disabled {
    background-color: #1c242c;
    border-color: #2c363f;
}

QFrame#settingsTile QCheckBox::indicator:checked:disabled {
    background-color: #24425f;
    border-color: #24425f;
}

/* Integrated Hotkeys destination */
QFrame#hotkeyInstructionCard,
QFrame#hotkeyShortcutCard {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 10px;
}

QLabel#hotkeyInstructionIcon {
    background-color: transparent;
    border: none;
}

QLabel#hotkeyInstructionText,
QLabel#hotkeyShortcutDescription {
    color: #98a3b0;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QLabel#hotkeyGroupTitle {
    color: #8d9aa7;
    background-color: transparent;
    border: none;
    font-size: 11px;
    font-weight: 700;
    padding-top: 2px;
}

QLabel#hotkeyShortcutName {
    color: #e8edf2;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 600;
}

QLineEdit#hotkeyInput {
    background-color: #161e26;
    color: #8fc2ff;
    border: 1px solid #3b4752;
    border-radius: 9px;
    padding: 6px 11px;
    font-size: 13px;
    font-weight: 600;
}

QLineEdit#hotkeyInput:focus {
    border-color: #318dff;
}

QLineEdit#hotkeyInput[capturing="true"] {
    background-color: #17345a;
    color: #ffffff;
    border-color: #318dff;
}

QPushButton#hotkeyClearButton,
QPushButton#hotkeyResetButton {
    color: #aeb8c3;
    background-color: #151c23;
    border: 1px solid #35404a;
    border-radius: 9px;
    font-size: 12px;
}

QPushButton#hotkeyClearButton:hover,
QPushButton#hotkeyResetButton:hover {
    color: #f0f3f6;
    background-color: #1b252e;
    border-color: #4b5966;
}

/* Spin boxes */
QSpinBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QSpinBox:focus {
    border: 1px solid #0a84ff;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-arrow {
    border-left: 2px solid #8e8e93;
    border-top: 2px solid #8e8e93;
    width: 6px;
    height: 6px;
    margin-top: 4px;
}

QSpinBox::down-arrow {
    border-left: 2px solid #8e8e93;
    border-bottom: 2px solid #8e8e93;
    width: 6px;
    height: 6px;
    margin-bottom: 4px;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #3a3a3c;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #0a84ff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #f5f5f7;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

/* Text edit (multi-line) */
QTextEdit {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.5;
    selection-background-color: #0a84ff;
}

QTextEdit:focus {
    border: 1px solid #0a84ff;
}

/* Scrollbar styling */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #48484a;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636366;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #48484a;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636366;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* Tab widget */
QTabWidget::pane {
    border: none;
    background-color: #1c1c1e;
}

QTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #0a84ff;
    border-bottom: 2px solid #0a84ff;
}

QTabBar::tab:hover {
    color: #f5f5f7;
}

/* Settings dialog tabs — segmented-button look so they clearly
   read as clickable (ID selector overrides the generic tab rules) */
#settingsTabs QTabBar::tab {
    background-color: #2c2c2e;
    color: #8e8e93;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 8px 20px;
    margin: 12px 4px;
    font-size: 14px;
    font-weight: 600;
}

/* Inset the strip from the dialog edge on styles that left-align it, in equal
   amounts so the styles that center it (macOS) stay centered. */
#settingsTabs QTabBar::tab:first {
    margin-left: 16px;
}

#settingsTabs QTabBar::tab:last {
    margin-right: 16px;
}

#settingsTabs QTabBar::tab:selected {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

#settingsTabs QTabBar::tab:hover:!selected {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
}

/* Cleanup sub-tabs — quieter underline style nested inside the segmented
   main settings tabs. Must come after #settingsTabs so these equal-
   specificity descendant rules win for the nested tab bar. */
#cleanupSubTabs QTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    border-radius: 0px;
    padding: 8px 18px;
    margin: 4px 2px 0px 2px;
    font-size: 13px;
    font-weight: 600;
}

#cleanupSubTabs QTabBar::tab:first {
    margin-left: 18px;
}

#cleanupSubTabs QTabBar::tab:selected {
    background-color: transparent;
    color: #0a84ff;
    border: none;
    border-bottom: 2px solid #0a84ff;
}

#cleanupSubTabs QTabBar::tab:hover:!selected {
    background-color: transparent;
    color: #f5f5f7;
    border: none;
}

QFrame#cleanupModelSummaryCard,
QFrame#meetingModelSummaryCard {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 12px;
}

QLabel#cleanupModelSummaryEyebrow,
QLabel#meetingModelSummaryEyebrow {
    color: #bf5af2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background-color: transparent;
    border: none;
}

QLabel#cleanupModelSummary,
QLabel#meetingModelSummary {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QLabel#cleanupModelSummaryHint,
QLabel#meetingModelSummaryHint {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
    border: none;
}

QPushButton#cleanupModelManagerLink,
QPushButton#meetingModelManagerLink {
    color: #0a84ff;
    background-color: transparent;
    border: none;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 0;
    min-height: 0;
}

QPushButton#cleanupModelManagerLink:hover,
QPushButton#meetingModelManagerLink:hover {
    color: #409cff;
    text-decoration: underline;
}

QPushButton#cleanupModelManagerLink:pressed,
QPushButton#meetingModelManagerLink:pressed {
    color: #0a84ff;
}

/* Transcript pane: one surface for the Fixed / Raw switch and the text. The
   text edit inside is borderless and gives up most of its top padding while
   the switch is up, so the two do not each add a full margin above line one. */
QFrame#transcriptPane {
    background-color: #2c2c2e;
    border: none;
    border-radius: 12px;
}

QWidget#transcriptSwitchRow {
    background-color: transparent;
}

QTextEdit#transcriptText,
QTextEdit#transcriptText:focus {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 16px;
}

QTextEdit#transcriptText[headed="true"] {
    padding-top: 6px;
}

QFrame#transcriptSwitch {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 7px;
}

QPushButton#transcriptSwitchBtn {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    border-radius: 5px;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#transcriptSwitchBtn:checked {
    background-color: #0a84ff;
    color: #ffffff;
}

QPushButton#transcriptSwitchBtn:hover:!checked {
    background-color: #2c2c2e;
    color: #f5f5f7;
}

/* Floating "open in a window" action in the pane's top-right corner. It sits
   over the text's padding, so it is transparent until hovered. */
QPushButton#transcriptExpandButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

QPushButton#transcriptExpandButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

QPushButton#transcriptExpandButton:pressed {
    background-color: rgba(255, 255, 255, 0.16);
}

/* Transcript reading window */
QDialog#transcriptViewerDialog {
    background-color: #1c1c1e;
}

QFrame#transcriptViewerToolbar {
    background-color: #1c1c1e;
    border: none;
    border-bottom: 1px solid #2c2c2e;
}

QLabel#transcriptViewerTitle {
    color: #f5f5f7;
    background-color: transparent;
    font-size: 15px;
    font-weight: 600;
}

QTabBar#transcriptViewerTabs {
    background-color: transparent;
}

QTabBar#transcriptViewerTabs::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px 7px 12px;
    margin: 0 2px;
    font-size: 12px;
    font-weight: 600;
    min-width: 58px;
    max-width: 112px;
}

QTabBar#transcriptViewerTabs::tab:selected {
    color: #f5f5f7;
    border-bottom-color: #0a84ff;
}

QTabBar#transcriptViewerTabs::tab:hover:!selected {
    color: #f5f5f7;
    background-color: rgba(255, 255, 255, 0.05);
}

QTextBrowser#transcriptViewerText,
QTextBrowser#transcriptViewerText:focus {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border: none;
    border-radius: 0;
    padding: 0;
    selection-background-color: #0a84ff;
}

QPushButton#transcriptViewerZoomButton {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 7px;
    padding: 0;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#transcriptViewerZoomButton:hover {
    background-color: #3a3a3c;
}

QPushButton#transcriptViewerZoomButton:disabled {
    color: #5c5c60;
    background-color: #242426;
}

QPushButton#transcriptViewerCopyButton {
    background-color: rgba(10, 132, 255, 0.14);
    color: #0a84ff;
    border: none;
    border-radius: 7px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#transcriptViewerCopyButton:hover {
    background-color: rgba(10, 132, 255, 0.24);
}

QPushButton#transcriptViewerCopyButton:disabled {
    color: #5c5c60;
    background-color: #242426;
}

/* Fixed / Raw transcript version toggle (History entry dialog) */
QPushButton#transcriptVersionBtn {
    background-color: #2c2c2e;
    color: #8e8e93;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#transcriptVersionBtn:checked {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

QPushButton#transcriptVersionBtn:hover:!checked {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
}

/* Menu bar */
QMenuBar {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border-bottom: 1px solid #2c2c2e;
    font-size: 13px;
}

QMenuBar::item {
    padding: 8px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2c2c2e;
    border-radius: 4px;
}

/* Menu */
QMenu {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

/* Checkboxes */
QCheckBox {
    color: #f5f5f7;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #0a84ff;
    border: 1px solid #0a84ff;
    image: url(ui_qt/assets/check.svg); /* Placeholder for check icon */
}

/* Frame for grouping */
QFrame {
    border: none;
}

/* Custom card widget */
QWidget#card {
    background-color: #2c2c2e;
    border-radius: 16px;
    border: 1px solid #3a3a3c; /* Subtle border */
}

QWidget#controlPanel {
    background-color: #2c2c2e;
    border-radius: 16px;
    padding: 20px;
}

/* Engine card on Quick Record / Upload File. Four labeled fields across the
   full width, then a footer line with the resolved engine and the two controls
   that apply to every backend. */
QFrame#engineCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QWidget#engineFieldGroup {
    background-color: transparent;
}

QLabel#engineFieldLabel {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
}

/* Recessed against the card. The global combo fill is the same color as the
   card, which would leave a field readable only by its 1px border. */
QComboBox#engineField,
QComboBox#engineFieldPrimary {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 5px 4px 5px 10px;
    font-size: 12px;
    min-height: 22px;
}

/* Extra left padding clears the status dot StatusFieldCombo parents to itself;
   the API backends have no local engine to report on, so the dot goes and the
   value moves back to the normal indent. */
QComboBox#engineFieldPrimary {
    font-weight: 600;
    padding-left: 26px;
}

QComboBox#engineFieldPrimary[dot="false"] {
    padding-left: 10px;
}

QComboBox#engineField:hover,
QComboBox#engineFieldPrimary:hover {
    border-color: #48484a;
}

QComboBox#engineField:focus,
QComboBox#engineFieldPrimary:focus,
QComboBox#engineField:on,
QComboBox#engineFieldPrimary:on {
    border-color: #0a84ff;
}

QComboBox#engineField:disabled,
QComboBox#engineFieldPrimary:disabled {
    color: #636366;
    background-color: #232325;
    border-color: #2f2f31;
}

QComboBox#engineField::drop-down,
QComboBox#engineFieldPrimary::drop-down {
    border: none;
    background-color: transparent;
    width: 20px;
}

/* The global fallback draws its arrow from two borders, which reads as a stray
   corner mark at this field size. */
QComboBox#engineField::down-arrow,
QComboBox#engineFieldPrimary::down-arrow {
    image: url(ui_qt/assets/tabler/chevron-down-gray.svg);
    border: none;
    width: 14px;
    height: 14px;
    margin-right: 5px;
}

/* StatusDot styles itself — see its docstring; one instance lives inside a
   QComboBox, which an application stylesheet cannot reach. */

QLabel#engineResolvedLabel {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
}

QCheckBox#engineCleanupCheck {
    color: #f5f5f7;
    font-size: 11px;
    spacing: 6px;
    background-color: transparent;
}

QCheckBox#engineCleanupCheck::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid #48484a;
    background-color: #1c1c1e;
}

QCheckBox#engineCleanupCheck::indicator:checked {
    background-color: #0a84ff;
    border-color: #0a84ff;
    image: url(ui_qt/assets/check.svg);
}

QCheckBox#engineCleanupCheck::indicator:hover {
    border-color: #0a84ff;
}

QPushButton#engineManageButton {
    color: #0a84ff;
    background-color: transparent;
    border: none;
    font-size: 11px;
    padding: 0 2px;
}

QPushButton#engineManageButton:hover {
    text-decoration: underline;
}

/* Content Tab Bar */
QTabBar#contentTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
    margin-right: 8px;
}

QTabBar#contentTabBar::tab:selected {
    color: #0a84ff;
    border-bottom: 2px solid #0a84ff;
}

QTabBar#contentTabBar::tab:hover:!selected {
    color: #f5f5f7;
}

QTabBar#contentTabBar::tab:disabled {
    color: #48484a;
}

/* Meeting Mode is the last tab. Grey it on macOS/Linux without disabling
   the tab, so a selected unsupported session is not stolen by Qt. */
QTabBar#contentTabBar[unsupportedMeeting="true"]::tab:last {
    color: #48484a;
}

QTabBar#contentTabBar[unsupportedMeeting="true"]::tab:last:hover {
    color: #636366;
}

QTabBar#contentTabBar[unsupportedMeeting="true"]::tab:last:selected {
    color: #636366;
    border-bottom: 2px solid #545456;
}

/* Tooltips — elevated surface so they read against the dark window.
   The window is made translucent by RoundedTooltipFilter so the
   border-radius renders with transparent corners. */
QToolTip {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #545456;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Learned Rules: layered profile, composer, and library surfaces */
QFrame#cleanupRulesHero {
    background-color: #202b3a;
    border: 1px solid #2d4a69;
    border-radius: 16px;
}

QLabel#cleanupRulesEyebrow {
    color: #64b5ff;
    background-color: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QLabel#cleanupRulesTitle {
    color: #ffffff;
    background-color: transparent;
    font-size: 21px;
    font-weight: 700;
}

QLabel#cleanupRulesDescription {
    color: #aeb9c6;
    background-color: transparent;
    font-size: 12px;
}

QLabel#cleanupRulesHeroMark,
QLabel#cleanupRuleDialogMark {
    color: #ffffff;
    background-color: #0a84ff;
    border: 1px solid #3298ff;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 800;
}

QFrame#cleanupRulesCard {
    background-color: #242426;
    border: 1px solid #39393d;
    border-radius: 14px;
}

QLabel#cleanupRulesSectionTitle {
    color: #f5f5f7;
    background-color: transparent;
    font-size: 15px;
    font-weight: 700;
}

QLabel#cleanupRulesSectionHint,
QLabel#cleanupRulesInteractionHint {
    color: #8e8e93;
    background-color: transparent;
    font-size: 11px;
}

QLabel#cleanupRulesCount {
    color: #64b5ff;
    background-color: #17283a;
    border: 1px solid #294866;
    border-radius: 10px;
    padding: 3px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLineEdit#cleanupRuleInput {
    background-color: #1c1c1e;
    border: 1px solid #48484a;
    border-radius: 10px;
    padding: 9px 13px;
}

QLineEdit#cleanupRuleInput:hover {
    border-color: #636366;
}

QLineEdit#cleanupRuleInput:focus {
    background-color: #202022;
    border: 1px solid #0a84ff;
}

QPushButton#cleanupRuleDictateButton,
QPushButton#cleanupRuleEditButton,
QPushButton#cleanupRuleDeleteButton,
QPushButton#cleanupRuleAddButton {
    min-height: 44px;
    max-height: 44px;
    border-radius: 10px;
    padding: 0 15px;
    font-size: 12px;
}

QPushButton#cleanupRuleAddButton {
    color: #ffffff;
    background-color: #0a84ff;
    border: 1px solid #3298ff;
}

QPushButton#cleanupRuleAddButton:hover {
    background-color: #2492ff;
}

QPushButton#cleanupRuleAddButton:disabled {
    color: #636366;
    background-color: #2c2c2e;
    border-color: #3a3a3c;
}

QPushButton#cleanupRuleDeleteButton {
    min-height: 38px;
    max-height: 38px;
    color: #ff6961;
    background-color: transparent;
    border: 1px solid #5b3434;
}

QPushButton#cleanupRuleDeleteButton:hover {
    color: #ffffff;
    background-color: #a93636;
    border-color: #c34545;
}

QPushButton#cleanupRuleDeleteButton:disabled {
    color: #636366;
    background-color: transparent;
    border-color: #3a3a3c;
}

QPushButton#cleanupRuleEditButton {
    min-height: 38px;
    max-height: 38px;
}

QLabel#cleanupRuleStatus {
    color: #8e8e93;
    background-color: transparent;
    min-height: 14px;
    font-size: 11px;
}

QListWidget#cleanupRulesList {
    color: #f5f5f7;
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}

QListWidget#cleanupRulesList::item {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 9px;
    padding: 11px 13px;
}

QListWidget#cleanupRulesList::item:hover {
    background-color: #2c2c2e;
    border-color: #545456;
}

QListWidget#cleanupRulesList::item:selected {
    color: #ffffff;
    background-color: #173d63;
    border: 1px solid #0a84ff;
}

QLabel#cleanupRulesEmpty {
    color: #77777c;
    background-color: #1f1f21;
    border: 1px dashed #48484a;
    border-radius: 10px;
    padding: 24px;
    font-size: 12px;
}

/* Learned Rule review dialog */
QDialog#cleanupRuleDialog {
    background-color: #19191b;
}

QLabel#cleanupRuleDialogTitle {
    color: #ffffff;
    background-color: transparent;
    font-size: 18px;
    font-weight: 700;
}

QLabel#cleanupRuleDialogSubtitle,
QLabel#cleanupRuleDialogInfo {
    color: #9a9aa0;
    background-color: transparent;
    font-size: 12px;
}

QLabel#cleanupRuleOriginal {
    color: #d6d6da;
    background-color: #242426;
    border-left: 3px solid #0a84ff;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 12px;
}

QLabel#cleanupRuleNotice {
    color: #ffd08a;
    background-color: #332817;
    border: 1px solid #64491f;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 11px;
}

QFrame#cleanupRuleEditorCard {
    background-color: #242426;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QLabel#cleanupRuleEditorLabel {
    color: #64b5ff;
    background-color: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QTextEdit#cleanupRuleEditor {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 11px;
}

QTextEdit#cleanupRuleEditor:focus {
    border: 1px solid #0a84ff;
}

/* ── Meeting Mode ─────────────────────────────────────────────── */

QWidget#meetingModeTab,
QWidget#meetingModeContent,
QWidget#meetingModeScrollHost {
    background-color: transparent;
}

QLabel#meetingModeSubtitle {
    color: #8e8e93;
    background-color: transparent;
}

QLabel#meetingModePlatformHint {
    color: #ff9f0a;
    background-color: transparent;
}

QLabel#meetingStatusPill {
    background-color: #0a84ff;
    color: #ffffff;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    min-width: 64px;
}

QLabel#meetingElapsedLabel {
    color: #f5f5f7;
    font-size: 18px;
    font-weight: 600;
    font-family: "Segoe UI", "Helvetica Neue", monospace;
    background-color: transparent;
    padding: 0 4px;
}

/* Start and End keep the accent colors their SuccessButton / DangerButton
   classes imply; the meeting-specific object names replace the class ones. */
QPushButton#meetingStartButton {
    background-color: #30d158;
    color: #ffffff;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    min-width: 220px;
}

QPushButton#meetingStartButton:hover {
    background-color: #28cd41;
}

QPushButton#meetingStartButton:pressed {
    background-color: #1fb34a;
}

QPushButton#meetingPauseButton,
QPushButton#meetingDashboardButton,
QPushButton#meetingGuestLinkButton {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
}

QPushButton#meetingEndButton {
    background-color: #ff453a;
    color: #ffffff;
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
}

QPushButton#meetingEndButton:hover {
    background-color: #ff3b30;
}

QPushButton#meetingEndButton:pressed {
    background-color: #d70015;
}

QPushButton#meetingEndButton:disabled {
    background-color: #2c2c2e;
    color: #636366;
}

QCheckBox#meetingCloudCheckbox {
    color: #8e8e93;
    font-size: 13px;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox#meetingCloudCheckbox:hover {
    color: #f5f5f7;
}

QToolButton#meetingCloudHelpIcon {
    color: #8e8e93;
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0px;
}

QToolButton#meetingCloudHelpIcon:hover {
    color: #f5f5f7;
    background-color: #3a3a3c;
    border-color: #636366;
}

QWidget#meetingModeTab QPushButton:focus,
QWidget#meetingModeTab QToolButton:focus,
QWidget#meetingModeTab QCheckBox:focus {
    border: 2px solid #64d2ff;
}

QDialog#meetingIntroDialog QPushButton:focus,
QDialog#meetingConsentDialog QPushButton:focus,
QDialog#meetingAudioConsentDialog QPushButton:focus,
QDialog#meetingUnsupportedDialog QPushButton:focus,
QDialog#meetingUnsupportedDialog QCheckBox:focus,
QDialog#meetingSystemAudioDialog QPushButton:focus,
QDialog#meetingLinuxAudioDialog QPushButton:focus,
QDialog#meetingLinuxAudioDialog QTextEdit:focus,
QDialog#meetingRecoveryDialog QPushButton:focus {
    border: 2px solid #64d2ff;
}

QWidget#meetingFinalizationCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QWidget#meetingFinalizationCard[finalizationTone="success"] {
    border: 1px solid #30d158;
}

QWidget#meetingFinalizationCard[finalizationTone="warning"] {
    border: 1px solid #ff9f0a;
}

QWidget#meetingFinalizationCard[finalizationTone="info"],
QWidget#meetingFinalizationCard[finalizationTone="neutral"] {
    border: 1px solid #0a84ff;
}

QLabel#meetingFinalizationIdentityTitle {
    color: #f5f5f7;
    background-color: transparent;
    font-size: 16px;
    font-weight: 700;
}

QLabel#meetingFinalizationIdentityMeta {
    color: #98989d;
    background-color: transparent;
    font-size: 12px;
}

QLabel#meetingFinalizationIdentityPill {
    color: #98989d;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#meetingFinalizationIdentityPill[pillTone="warning"] {
    color: #ff9f0a;
    background-color: rgba(255, 159, 10, 0.15);
    border: 1px solid rgba(255, 159, 10, 0.35);
}

QLabel#meetingFinalizationIdentityPill[pillTone="success"] {
    color: #30d158;
    background-color: rgba(48, 209, 88, 0.15);
    border: 1px solid rgba(48, 209, 88, 0.35);
}

QLabel#meetingFinalizationIdentityPill[pillTone="neutral"] {
    color: #98989d;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QLabel#meetingFinalizationTitle {
    color: #f5f5f7;
    background-color: transparent;
    font-size: 14px;
    font-weight: 600;
}

QLabel#meetingFinalizationStepBadge {
    color: #0a84ff;
    background-color: rgba(10, 132, 255, 0.15);
    border: 1px solid rgba(10, 132, 255, 0.35);
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#meetingFinalizationStepBadge[badgeTone="success"] {
    color: #30d158;
    background-color: rgba(48, 209, 88, 0.15);
    border: 1px solid rgba(48, 209, 88, 0.35);
}

QLabel#meetingFinalizationStepBadge[badgeTone="warning"] {
    color: #ff9f0a;
    background-color: rgba(255, 159, 10, 0.15);
    border: 1px solid rgba(255, 159, 10, 0.35);
}

QWidget#meetingFinalizationActiveBox {
    background-color: rgba(0, 0, 0, 0.22);
    border: 1px solid #3a3a3c;
    border-radius: 8px;
}

QLabel#meetingFinalizationMessage {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
}

QLabel#meetingFinalizationDetail {
    color: #98989d;
    font-size: 11px;
    background-color: transparent;
}

QLabel#meetingFinalizationKeepHint {
    color: #98989d;
    font-size: 11px;
    background-color: transparent;
}

QWidget#meetingFinalizationStepsWidget {
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid #3a3a3c;
    border-radius: 8px;
}

QWidget#meetingFinalizationStepRow {
    background-color: transparent;
}

QLabel#meetingFinalizationStepName {
    color: #d1d1d6;
    background-color: transparent;
}

QLabel#meetingFinalizationStepDetail {
    color: #8e8e93;
    background-color: transparent;
}

QProgressBar#meetingFinalizationProgress {
    background-color: #3a3a3c;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}

QProgressBar#meetingFinalizationProgress::chunk {
    background-color: #0a84ff;
    border-radius: 3px;
}

QFrame#meetingFinalizationDivider {
    background-color: #3a3a3c;
    border: none;
    max-height: 1px;
}

QWidget#meetingFinalizationFooter,
QWidget#meetingFinalizationLinksRow,
QWidget#meetingFinalizationDecisionsRow {
    background-color: transparent;
}

/* First footer tier: flat links that open or repeat something. */
QPushButton[meetingFooterLink="true"] {
    color: #0a84ff;
    background-color: transparent;
    border: none;
    padding: 2px 0;
    font-size: 12px;
    font-weight: 600;
    min-width: 0;
    min-height: 0;
}

QPushButton[meetingFooterLink="true"]:hover {
    color: #4aa8ff;
    background-color: transparent;
}

QPushButton[meetingFooterLink="true"]:pressed {
    color: #0062cc;
    background-color: transparent;
}

QPushButton[meetingFooterLink="true"]:disabled {
    color: #636366;
    background-color: transparent;
}

/* Second footer tier: filled decisions, centered. */
QPushButton[meetingFooterDecision="true"] {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 0;
    min-height: 0;
}

QPushButton[meetingFooterDecision="true"]:hover {
    background-color: #48484a;
}

QPushButton[meetingFooterDecision="true"]:pressed {
    background-color: #2c2c2e;
}

QPushButton#meetingFinalizationRetryButton {
    background-color: #0a84ff;
    color: #ffffff;
}

QPushButton#meetingFinalizationRetryButton:hover {
    background-color: #339dff;
}

QPushButton#meetingFinalizationRetryButton:pressed {
    background-color: #0062cc;
}

QPushButton#meetingFinalizationDoneButton {
    background-color: #30d158;
    color: #ffffff;
}

QPushButton#meetingFinalizationDoneButton:hover {
    background-color: #28cd41;
}

QPushButton#meetingFinalizationDoneButton:pressed {
    background-color: #1fb34a;
}

QPushButton#meetingFinalizationStepAction {
    color: #0a84ff;
    background-color: transparent;
    border: none;
    padding: 0 4px;
    font-size: 11px;
    min-width: 0;
    min-height: 0;
}

QDialog#meetingConsentDialog,
QDialog#meetingRecoveryDialog,
QDialog#meetingIntroDialog {
    background-color: #1c1c1e;
    color: #f5f5f7;
}

/* Export dialog shares the Settings / Model Manager slate palette. */
QDialog#meetingExportDialog,
QDialog#historyExportDialog {
    background-color: #10161c;
    color: #f5f5f7;
}

QFrame#meetingExportCard,
QFrame#historyExportCard {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 10px;
}

/* Plain QWidget containers paint the global background; keep the card
   surface visible behind the scope panels. */
QWidget#meetingExportPane,
QWidget#historyExportPane {
    background-color: transparent;
}

QLabel#meetingExportEyebrow,
QLabel#historyExportEyebrow {
    color: #64b5ff;
    background-color: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QLabel#meetingExportMeta,
QLabel#meetingExportProgress,
QLabel#historyExportMeta,
QLabel#historyExportProgress {
    color: #9da8b5;
    background-color: transparent;
    font-size: 12px;
}

/* The global QWidget rule paints an opaque background; without these the
   check and radio labels sit in dark bars on top of the lighter cards. */
QDialog#meetingExportDialog QCheckBox,
QDialog#historyExportDialog QCheckBox {
    color: #e8edf2;
    background-color: transparent;
    spacing: 8px;
    font-size: 13px;
}

QDialog#meetingExportDialog QCheckBox:disabled,
QDialog#historyExportDialog QCheckBox:disabled {
    color: #5c6770;
}

QDialog#meetingExportDialog QRadioButton,
QDialog#historyExportDialog QRadioButton {
    color: #e8edf2;
    spacing: 8px;
    font-size: 13px;
    background-color: transparent;
}

/* Both states total 18px (content + border) so the indicator stays a
   circle and the label never shifts when toggled. */
QDialog#meetingExportDialog QRadioButton::indicator,
QDialog#historyExportDialog QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a4652;
    border-radius: 9px;
    background-color: #0f141a;
}

QDialog#meetingExportDialog QRadioButton::indicator:checked,
QDialog#historyExportDialog QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    border: 5px solid #0a84ff;
    background-color: #ffffff;
}

QDialog#meetingExportDialog QLineEdit,
QDialog#historyExportDialog QLineEdit {
    background-color: #0f141a;
    color: #f2f5f8;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QDialog#meetingExportDialog QLineEdit:focus,
QDialog#historyExportDialog QLineEdit:focus {
    border: 1px solid #0a84ff;
}

QDialog#meetingExportDialog QComboBox,
QDialog#historyExportDialog QComboBox {
    background-color: #0f141a;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QDialog#meetingExportDialog QComboBox::down-arrow,
QDialog#historyExportDialog QComboBox::down-arrow {
    image: url(ui_qt/assets/tabler/chevron-down-slate.svg);
    border: none;
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

QListWidget#meetingExportList,
QListWidget#historyExportList {
    background-color: #0f141a;
    color: #f5f5f7;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 4px;
    font-size: 12px;
    min-width: 0;
}

QListWidget#meetingExportList::item,
QListWidget#historyExportList::item {
    padding: 6px 8px;
    border-radius: 6px;
}

QListWidget#meetingExportList::item:hover,
QListWidget#historyExportList::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListWidget#meetingExportList::item:selected,
QListWidget#historyExportList::item:selected {
    background-color: rgba(10, 132, 255, 0.16);
}

QListWidget#meetingExportList::indicator,
QListWidget#historyExportList::indicator {
    width: 16px;
    height: 16px;
    background-color: #141b22;
    border: 1px solid #3a4652;
    border-radius: 4px;
}

QListWidget#meetingExportList::indicator:checked,
QListWidget#historyExportList::indicator:checked {
    background-color: #0a84ff;
    border: 1px solid #0a84ff;
    image: url(ui_qt/assets/check.svg);
}

QDialog#meetingExportDialog QDateEdit,
QDialog#historyExportDialog QDateEdit {
    background-color: #0f141a;
    color: #f2f5f8;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 13px;
    min-width: 0;
}

QDialog#meetingExportDialog QDateEdit::drop-down,
QDialog#historyExportDialog QDateEdit::drop-down {
    border: none;
    background-color: transparent;
    width: 24px;
}

QDialog#meetingExportDialog QDateEdit::down-arrow,
QDialog#historyExportDialog QDateEdit::down-arrow {
    image: url(ui_qt/assets/tabler/chevron-down-slate.svg);
    border: none;
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

QDialog#meetingExportDialog QCalendarWidget,
QDialog#historyExportDialog QCalendarWidget {
    background-color: #1b242e;
    color: #f5f5f7;
}

QPushButton#meetingExportMiniBtn,
QPushButton#historyExportMiniBtn {
    background-color: #1b242e;
    color: #e8edf2;
    border: 1px solid #303b45;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#meetingExportMiniBtn:hover,
QPushButton#historyExportMiniBtn:hover {
    background-color: #232f3b;
    border-color: #3a4652;
}

QLabel#meetingIntroLead {
    color: #d1d1d6;
    font-size: 14px;
    background-color: transparent;
}

QFrame#meetingIntroSection {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QLabel#meetingIntroBullet {
    color: #0a84ff;
    font-size: 14px;
    font-weight: 700;
    background-color: transparent;
    min-width: 12px;
}

QLabel#meetingIntroItem {
    color: #f5f5f7;
    font-size: 13px;
    background-color: transparent;
}

QLabel#consentBodyLabel {
    color: #d1d1d6;
    font-size: 13px;
    background-color: transparent;
    line-height: 1.4;
}

QFrame#meetingRecoveryRow {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QLabel#meetingRecoveryRowLabel {
    color: #f5f5f7;
    font-size: 13px;
    background-color: transparent;
}

QPushButton#meetingConsentNotNowButton,
QPushButton#meetingConsentEnableButton,
QPushButton#meetingRecoveryCloseButton,
QPushButton#meetingRecoveryFinalizeButton,
QPushButton#meetingRecoveryDiscardButton,
QPushButton#meetingIntroSkipButton,
QPushButton#meetingIntroGotItButton {
    padding: 8px 16px;
    font-size: 13px;
}

QLabel#meetingBindWarning {
    background-color: #2b2118;
    border: 1px solid #8a5a14;
    border-radius: 8px;
    color: #ffd60a;
    font-size: 12px;
    padding: 8px 10px;
}

/* Update dialog */

QDialog#appUpdateDialog {
    background-color: #1c1c1e;
}

QLabel#updateTitleLabel {
    color: #ffffff;
    font-size: 19px;
    font-weight: 700;
    background-color: transparent;
}

QLabel#updateBodyLabel {
    color: #98989d;
    font-size: 13px;
    background-color: transparent;
}

QLabel#updateBodyLabel[tone="error"] {
    color: #ff6b6b;
}

QFrame#updateNotesCard {
    background-color: #232326;
    border: 1px solid #313135;
    border-radius: 12px;
}

QLabel#updateNotesCaption {
    color: #7d7d82;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background-color: transparent;
}

QTextBrowser#updateNotesView {
    background-color: transparent;
    border: none;
    padding: 0px 10px 0px 0px;
    font-size: 13px;
}

QTextBrowser#updateNotesView QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

QTextBrowser#updateNotesView QScrollBar::handle:vertical {
    background-color: #48484a;
    border-radius: 3px;
    margin: 0px;
    min-height: 24px;
}

QTextBrowser#updateNotesView QScrollBar::handle:vertical:hover {
    background-color: #636366;
}

QTextBrowser#updateNotesView QScrollBar::add-page:vertical,
QTextBrowser#updateNotesView QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QLabel#updateHintLabel {
    color: #98989d;
    font-size: 12px;
    background-color: transparent;
}

QFrame#updateProgressPanel {
    background-color: #232326;
    border: 1px solid #313135;
    border-radius: 12px;
}

QLabel#updateProgressDetail {
    color: #98989d;
    font-size: 12px;
    background-color: transparent;
}

QLabel#updateProgressPercent {
    color: #6fb1ff;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}

QFrame#updateFooterDivider {
    background-color: #2f2f33;
    border: none;
}

QDialog#appUpdateDialog QCheckBox {
    color: #b0b0b5;
    font-size: 13px;
}

QDialog#appUpdateDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
}

QDialog#appUpdateDialog QPushButton {
    padding: 9px 18px;
    font-size: 13px;
}

/* Upload File: the loaded-file card and the inline progress it shows while a
   job runs. A QFrame so the surface paints; every label inside sets its own
   transparent background because the global QWidget fill would otherwise
   paint a dark block behind each one. */
QFrame#uploadFileCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 16px;
}

QStackedWidget#uploadFooter,
QWidget#uploadActions,
QFrame#uploadProgressPanel {
    background-color: transparent;
    border: none;
}

QLabel#uploadFileIcon {
    background-color: rgba(10, 132, 255, 0.14);
    border-radius: 12px;
}

QLabel#uploadFileName {
    color: #f5f5f7;
    font-size: 15px;
    font-weight: 600;
    background-color: transparent;
}

QLabel#uploadMetaChip {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    color: #c7c7cc;
}

QLabel#uploadChunkChip {
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#uploadChunkChip[tone="ok"] {
    background-color: rgba(48, 209, 88, 0.14);
    color: #30d158;
}

QLabel#uploadChunkChip[tone="warn"] {
    background-color: rgba(255, 159, 10, 0.16);
    color: #ff9f0a;
}

QPushButton#uploadRemoveButton {
    background-color: transparent;
    color: #8e8e93;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
}

QPushButton#uploadRemoveButton:hover {
    background-color: rgba(255, 69, 58, 0.14);
    color: #ff453a;
}

QPushButton#uploadRemoveButton:disabled {
    color: #48484a;
    background-color: transparent;
}

QFrame#uploadCardDivider {
    background-color: #3a3a3c;
}

QLabel#uploadProgressTitle {
    color: #f5f5f7;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
}

QLabel#uploadProgressTitle[stage="done"] {
    color: #30d158;
}

QLabel#uploadProgressTitle[stage="failed"] {
    color: #ff453a;
}

QLabel#uploadProgressTitle[stage="canceled"] {
    color: #ff9f0a;
}

QLabel#uploadProgressElapsed {
    color: #8e8e93;
    font-size: 12px;
    background-color: transparent;
}

QLabel#uploadProgressDetail {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
}

QFrame#uploadStepConnector {
    background-color: #3a3a3c;
}

QLabel#uploadStepDot {
    border-radius: 4px;
    background-color: #48484a;
}

QLabel#uploadStepDot[stepState="active"] {
    background-color: #0a84ff;
}

QLabel#uploadStepDot[stepState="done"] {
    background-color: #30d158;
}

QLabel#uploadStepDot[stepState="failed"] {
    background-color: #ff453a;
}

QLabel#uploadStepTitle {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
}

QLabel#uploadStepTitle[stepState="active"] {
    color: #f5f5f7;
    font-weight: 600;
}

QLabel#uploadStepTitle[stepState="done"] {
    color: #c7c7cc;
}

QLabel#uploadStepTitle[stepState="failed"] {
    color: #ff453a;
}

/* Copy sits on the card, and the default button fill is the card color, so it
   needs its own surface. Inactive (no transcript yet) reads as an outline. */
QPushButton#uploadCopyButton {
    background-color: #3a3a3c;
    color: #f5f5f7;
    font-size: 14px;
}

QPushButton#uploadCopyButton:hover {
    background-color: #48484a;
}

QPushButton#uploadCopyButton:pressed {
    background-color: #2c2c2e;
}

QPushButton#uploadCopyButton[inactive="true"],
QPushButton#uploadCopyButton[inactive="true"]:hover,
QPushButton#uploadCopyButton[inactive="true"]:pressed {
    background-color: transparent;
    color: #636366;
    border: 1px solid #3a3a3c;
}

QLabel#uploadResultNote {
    color: #8e8e93;
    font-size: 12px;
    background-color: transparent;
}

/* Multi-file upload: the queue that replaces the single-file header when two
   or more files are dropped. Containers are plain widgets and must not pick
   up the global QWidget fill; rows are frames that carry their state. */
QWidget#uploadFileHeader,
QWidget#uploadQueue,
QWidget#uploadRelationRow {
    background-color: transparent;
    border: none;
}

QLabel#uploadQueueTitle {
    color: #f5f5f7;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
}

QLabel#uploadQueueNote {
    color: #8e8e93;
    font-size: 12px;
    background-color: transparent;
}

QLabel#uploadQueueNote[tone="warn"] {
    color: #ff9f0a;
}

QFrame#uploadQueueRow {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QFrame#uploadQueueRow[state="active"] {
    border-color: #0a84ff;
    background-color: rgba(10, 132, 255, 0.08);
}

QFrame#uploadQueueRow[state="done"] {
    border-color: rgba(48, 209, 88, 0.45);
}

QFrame#uploadQueueRow[state="failed"] {
    border-color: rgba(255, 69, 58, 0.55);
    background-color: rgba(255, 69, 58, 0.06);
}

QLabel#uploadQueueRowIcon {
    background-color: rgba(10, 132, 255, 0.14);
    border-radius: 8px;
}

QLabel#uploadQueueRowName {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

QLabel#uploadRowState {
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    background-color: #1c1c1e;
    color: #8e8e93;
}

QLabel#uploadRowState[state="active"] {
    background-color: rgba(10, 132, 255, 0.16);
    color: #0a84ff;
}

QLabel#uploadRowState[state="done"] {
    background-color: rgba(48, 209, 88, 0.14);
    color: #30d158;
}

QLabel#uploadRowState[state="failed"] {
    background-color: rgba(255, 69, 58, 0.14);
    color: #ff453a;
}

QPushButton#uploadRowMoveButton,
QPushButton#uploadRowRemoveButton,
QPushButton#uploadRowCopyButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

QPushButton#uploadRowMoveButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#uploadRowCopyButton:hover {
    background-color: rgba(10, 132, 255, 0.16);
}

QPushButton#uploadRowRemoveButton:hover {
    background-color: rgba(255, 69, 58, 0.16);
}

QPushButton#uploadRowMoveButton:disabled,
QPushButton#uploadRowRemoveButton:disabled {
    background-color: transparent;
}

QPushButton#uploadAddFilesButton {
    background-color: rgba(10, 132, 255, 0.12);
    color: #0a84ff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
}

QPushButton#uploadAddFilesButton:hover {
    background-color: rgba(10, 132, 255, 0.22);
}

QPushButton#uploadAddFilesButton:disabled {
    background-color: transparent;
    color: #48484a;
}

QLabel#uploadRelationLabel {
    color: #c7c7cc;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}

QComboBox#uploadRelationCombo {
    padding: 5px 12px;
    font-size: 13px;
    min-height: 28px;
}

QLabel#uploadRelationHint {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
}

QPushButton#uploadRelationEditButton {
    background-color: transparent;
    color: #0a84ff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 6px;
}

QPushButton#uploadRelationEditButton:hover {
    background-color: rgba(10, 132, 255, 0.12);
}

QLabel#uploadProgressBatch {
    color: #c7c7cc;
    font-size: 12px;
    background-color: transparent;
}

QPushButton#uploadStopButton {
    background-color: transparent;
    color: #8e8e93;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 6px;
}

QPushButton#uploadStopButton:hover {
    background-color: rgba(255, 69, 58, 0.14);
    color: #ff453a;
}

QPushButton#uploadStopButton:disabled {
    color: #48484a;
    background-color: transparent;
}

/* Custom relation dialog for a multi-file upload. */
QDialog#batchRelationDialog {
    background-color: #1c1c1e;
}

QLabel#batchRelationTitle {
    color: #f5f5f7;
    background-color: transparent;
}

QLabel#batchRelationInfo {
    color: #8e8e93;
    font-size: 12px;
    background-color: transparent;
}

QFrame#batchRelationFilesCard,
QFrame#batchRelationEditorCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QLabel#batchRelationFilesLabel,
QLabel#batchRelationEditorLabel {
    color: #8e8e93;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background-color: transparent;
}

QLabel#batchRelationFileName {
    color: #c7c7cc;
    font-size: 12px;
    background-color: transparent;
}

QTextEdit#batchRelationEditor {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    color: #f5f5f7;
    padding: 8px;
}

QCheckBox#batchRelationCombine {
    color: #f5f5f7;
    font-size: 13px;
    background-color: transparent;
}
