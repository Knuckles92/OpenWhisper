/* Modern PyQt6 Theme Stylesheet - Apple-like Redesign */
/* Dark mode with soft grays, blurred backgrounds, and vibrant accents */

/* Main color palette */
QMainWindow {
    background-color: #1c1c1e; /* Apple Dark Mode Background */
    color: #f5f5f7; /* Apple Text White */
}

QWidget {
    background-color: #1c1c1e;
    color: #f5f5f7;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px; /* Increased base font size */
}

/* Top-level dialogs */
QDialog {
    background-color: #1c1c1e;
    color: #f5f5f7;
}

/* Hotkey display elements with smooth transitions */
/* Note: QSS doesn't support CSS transitions - animations are handled in Python code */
HotkeyKey {
    /* Transitions handled programmatically in hotkey_display.py */
}

HotkeyKey:hover {
    /* Hover effects handled programmatically */
}

/* Standard buttons with modern styling */
QPushButton {
    background-color: #2c2c2e; /* Secondary System Fill */
    color: #0a84ff; /* Apple System Blue */
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 14px;
    outline: none;
}

QPushButton:hover {
    background-color: #3a3a3c;
}

QPushButton:pressed {
    background-color: #1c1c1e;
    color: #007aff; /* Darker Blue */
}

QPushButton:disabled {
    color: #636366; /* Label Color Secondary */
    background-color: #2c2c2e;
}

/* Primary action buttons (more prominent) */
QPushButton#primaryButton {
    background-color: #0a84ff;
    color: #ffffff;
    font-size: 15px;
    padding: 12px 24px;
}

QPushButton#primaryButton:hover {
    background-color: #007aff;
}

QPushButton#primaryButton:pressed {
    background-color: #0062cc;
}

/* Danger buttons (for cancel/stop) */
QPushButton#dangerButton {
    background-color: #ff453a; /* Apple System Red */
    color: #ffffff;
}

QPushButton#dangerButton:hover {
    background-color: #ff3b30;
}

QPushButton#dangerButton:pressed {
    background-color: #d70015;
}

/* Success buttons */
QPushButton#successButton {
    background-color: #30d158; /* Apple System Green */
    color: #ffffff;
}

QPushButton#successButton:hover {
    background-color: #28cd41;
}

QPushButton#successButton:pressed {
    background-color: #1fb34a;
}

/* Warning buttons (yellow/amber) */
QPushButton#warningButton {
    background-color: #ff9f0a; /* Apple System Orange */
    color: #ffffff;
}

QPushButton#warningButton:hover {
    background-color: #ff9500;
}

QPushButton#warningButton:pressed {
    background-color: #cc7700;
}

/* ComboBox (Model selector) */
QComboBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 24px;
}

QComboBox::down-arrow {
    image: none; /* TODO: Add SVG icon if possible, or use character */
    border-left: 2px solid #8e8e93;
    border-bottom: 2px solid #8e8e93;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    /* Note: CSS transform is not supported in QSS */
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #f5f5f7;
    selection-background-color: #0a84ff;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

/* Label styling */
QLabel {
    color: #f5f5f7;
    font-size: 14px;
}

QLabel#headerLabel {
    color: #ffffff;
    font-weight: 700;
    font-size: 18px; /* Larger headers */
}

QLabel#statusLabel {
    color: #8e8e93; /* Secondary Label Color */
    font-size: 13px;
}

QLabel#accentLabel {
    color: #0a84ff;
    font-weight: 600;
}

/* Section headings inside dialogs and panels */
QLabel#sectionLabel {
    color: #8e8e93;
    font-weight: 600;
    font-size: 13px;
}

/* Small hint/help text under controls */
QLabel#infoLabel {
    color: #8e8e93;
    font-size: 12px;
}

/* Text input fields */
QLineEdit {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QLineEdit:focus {
    border: 1px solid #0a84ff;
}

/* Model Manager — dense dark desktop treatment */
QDialog#modelManagerDialog {
    background-color: #10161c;
}

QWidget#modelManagerVoiceTab,
QWidget#modelManagerTextTab,
QWidget#modelManagerMeetingTab {
    background-color: #10161c;
}

QWidget#textModelPicker {
    background-color: transparent;
}

QLabel#modelManagerHeaderIcon {
    background-color: #121d28;
    border: 1px solid #268cff;
    border-radius: 13px;
    padding: 3px;
}

QLabel#modelManagerTitle {
    color: #f2f5f8;
    font-size: 22px;
    font-weight: 700;
    background-color: transparent;
    border: none;
}

QLabel#modelManagerSubtitle {
    color: #9da8b5;
    font-size: 13px;
    background-color: transparent;
    border: none;
}

QTabWidget#modelManagerTabs::pane {
    border: none;
    border-top: 1px solid #29333d;
    background-color: transparent;
    top: -1px;
}

#modelManagerTabs QTabBar::tab {
    background-color: #141b22;
    color: #a8b1bd;
    border: 1px solid #35404a;
    min-width: 160px;
    min-height: 32px;
    padding: 5px 16px;
    margin: 8px 0px 10px 0px;
    font-size: 14px;
    font-weight: 600;
}

#modelManagerTabs QTabBar::tab:first {
    border-top-left-radius: 11px;
    border-bottom-left-radius: 11px;
}

#modelManagerTabs QTabBar::tab:last {
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
}

#modelManagerTabs QTabBar::tab:selected {
    background-color: #172b45;
    color: #edf6ff;
    border-color: #318dff;
}

#modelManagerTabs QTabBar::tab:hover:!selected {
    background-color: #1a232c;
    color: #f2f5f8;
    border-color: #52606d;
}

QFrame#textTabAccent,
QFrame#meetingTabAccent {
    background-color: #2793ff;
    border: none;
    border-radius: 1px;
}

QLabel#textTabTitle,
QLabel#meetingTabTitle {
    color: #f1f4f7;
    background-color: transparent;
    border: none;
    font-size: 18px;
    font-weight: 700;
}

QLabel#textTabSubtitle,
QLabel#meetingTabSubtitle {
    color: #98a3b0;
    background-color: transparent;
    border: none;
    font-size: 13px;
}

QFrame#textModelSectionCard {
    background-color: #141b22;
    border: 1px solid #35404a;
    border-radius: 12px;
}

QLabel#textModelStepNumber {
    color: #eaf4ff;
    background-color: #152130;
    border: 1px solid #2d91ff;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
}

QLabel#textModelStepTitle {
    color: #f0f3f6;
    background-color: transparent;
    border: none;
    font-size: 15px;
    font-weight: 700;
}

QFrame#textProviderIdentityCard {
    background-color: #111820;
    border: 1px solid #242e37;
    border-radius: 11px;
}

QLabel#textProviderMark {
    color: #ffffff;
    background-color: #5e5ce6;
    border: 1px solid #827fff;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
}

QLabel#textProviderTitle {
    color: #f0f3f6;
    font-size: 15px;
    font-weight: 700;
    background-color: transparent;
    border: none;
}

QLabel#textProviderDescription,
QLabel#textModelStatus,
QLabel#textModelFootnote {
    color: #98a3b0;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

QLabel#textProviderCredentialIcon,
QLabel#textModelActiveIcon,
QLabel#textModelCatalogIcon,
QLabel#textCurrentModelIcon,
QLabel#textModelFootnoteIcon {
    background-color: transparent;
    border: none;
}

QLabel#textProviderRequirement {
    color: #e0a052;
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
}

QLabel#textProviderRequirement[available="true"] {
    color: #30d158;
}

QFrame#textModelActiveCard {
    background-color: #0f2a21;
    border: 1px solid #217353;
    border-radius: 10px;
}

QLabel#textModelActiveSummary {
    color: #42df91;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 600;
}

QLabel#textModelFieldLabel {
    color: #9da8b5;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QComboBox#textModelProviderCombo,
QComboBox#textModelSort,
QComboBox#textModelCombo {
    color: #eef2f6;
    background-color: #161e26;
    border: 1px solid #3b4752;
    border-radius: 9px;
    font-size: 14px;
    padding-left: 12px;
    padding-right: 32px;
}

QComboBox#textModelProviderCombo {
    font-weight: 600;
}

QComboBox#textModelProviderCombo:focus,
QComboBox#textModelSort:focus,
QComboBox#textModelCombo:focus {
    border-color: #0a84ff;
}

QComboBox#textModelProviderCombo::down-arrow,
QComboBox#textModelSort::down-arrow,
QComboBox#textModelCombo::down-arrow {
    image: url(ui_qt/assets/tabler/chevron-down-slate.svg);
    border: none;
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

QFrame#textModelCatalogSummary {
    background-color: #111820;
    border: 1px solid #242e37;
    border-radius: 10px;
}

QFrame#textModelCatalogSeparator {
    background-color: transparent;
    border: none;
    border-top: 1px dashed #3a4651;
}

QFrame#textCurrentModelCard {
    min-width: 140px;
    background-color: #12231f;
    border: 1px solid #204438;
    border-radius: 9px;
}

QLabel#textCurrentModelEyebrow {
    color: #a7b0bb;
    background-color: transparent;
    border: none;
    font-size: 11px;
}

QLabel#textCurrentModelValue {
    color: #f0f5f3;
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#textModelRefreshButton {
    color: #4aa0ff;
    background-color: #141b22;
    border: 1px solid #318dff;
    border-radius: 9px;
    padding: 6px 12px;
}

QPushButton#textModelRefreshButton:hover {
    color: #83bdff;
    background-color: #172538;
    border-color: #62aaff;
}

QPushButton#textModelActivateButton {
    color: #eef6ff;
    background-color: #17345a;
    border: 1px solid #318dff;
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 14px;
}

QPushButton#textModelActivateButton:hover {
    background-color: #1c4678;
    border-color: #66adff;
}

QPushButton#textModelActivateButton:disabled,
QPushButton#textModelActivateButton[current="true"] {
    color: #dcecff;
    background-color: #1a3c68;
    border-color: #3b95ff;
}

QFrame#textModelFootnoteCard {
    background-color: #141b22;
    border: 1px solid #303b45;
    border-radius: 10px;
}

QLabel#modelManagerMessage {
    color: #8e99a6;
    background-color: transparent;
    border: none;
    font-size: 12px;
}

QPushButton#modelManagerCloseButton {
    color: #aeb8c3;
    background-color: #151c23;
    border: 1px solid #35404a;
    border-radius: 9px;
    font-size: 13px;
}

QPushButton#modelManagerCloseButton:hover {
    color: #f0f3f6;
    background-color: #1b252e;
    border-color: #4b5966;
}

QLabel#modelManagerCachePath {
    color: #636366;
    font-size: 10px;
    background-color: transparent;
    border: none;
}

QLabel#modelManagerStatValue {
    color: #f5f5f7;
    font-size: 12px;
    font-weight: 700;
    background-color: transparent;
    border: none;
}

QLabel#modelManagerStatLabel {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
    border: none;
}

QWidget#modelManagerStat {
    background-color: transparent;
}

QLineEdit#modelManagerSearch,
QComboBox#modelManagerSort,
QComboBox#modelManagerStatusFilter {
    min-height: 32px;
    max-height: 32px;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
}

QComboBox#modelManagerSort {
    min-width: 160px;
    padding-right: 28px;
}

QComboBox#modelManagerStatusFilter {
    min-width: 140px;
    padding-right: 28px;
}

QLabel#modelManagerEnvBanner {
    color: #ff9f0a;
    background-color: rgba(255, 159, 10, 0.1);
    border: 1px solid rgba(255, 159, 10, 0.35);
    border-radius: 8px;
    padding: 8px 12px;
}

/* Hotkey capture fields (HotkeyDialog) — the capturing state is toggled
   via a dynamic "capturing" property from Python */
QLineEdit#hotkeyInput {
    background-color: #2c2c2e;
    color: #0a84ff;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 600;
}

QLineEdit#hotkeyInput:focus {
    border: 1px solid #0a84ff;
}

QLineEdit#hotkeyInput[capturing="true"] {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

/* Spin boxes */
QSpinBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    selection-background-color: #0a84ff;
}

QSpinBox:focus {
    border: 1px solid #0a84ff;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-arrow {
    border-left: 2px solid #8e8e93;
    border-top: 2px solid #8e8e93;
    width: 6px;
    height: 6px;
    margin-top: 4px;
}

QSpinBox::down-arrow {
    border-left: 2px solid #8e8e93;
    border-bottom: 2px solid #8e8e93;
    width: 6px;
    height: 6px;
    margin-bottom: 4px;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #3a3a3c;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #0a84ff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #f5f5f7;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

/* Text edit (multi-line) */
QTextEdit {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.5;
    selection-background-color: #0a84ff;
}

QTextEdit:focus {
    border: 1px solid #0a84ff;
}

/* Scrollbar styling */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #48484a;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636366;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #48484a;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636366;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tab widget */
QTabWidget::pane {
    border: none;
    background-color: #1c1c1e;
}

QTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #0a84ff;
    border-bottom: 2px solid #0a84ff;
}

QTabBar::tab:hover {
    color: #f5f5f7;
}

/* Settings dialog tabs — segmented-button look so they clearly
   read as clickable (ID selector overrides the generic tab rules) */
#settingsTabs QTabBar::tab {
    background-color: #2c2c2e;
    color: #8e8e93;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 8px 20px;
    margin: 12px 4px;
    font-size: 14px;
    font-weight: 600;
}

#settingsTabs QTabBar::tab:first {
    margin-left: 16px;
}

#settingsTabs QTabBar::tab:selected {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

#settingsTabs QTabBar::tab:hover:!selected {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
}

/* Cleanup sub-tabs — quieter underline style nested inside the segmented
   main settings tabs. Must come after #settingsTabs so these equal-
   specificity descendant rules win for the nested tab bar. */
#cleanupSubTabs QTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    border-radius: 0px;
    padding: 8px 18px;
    margin: 4px 2px 0px 2px;
    font-size: 13px;
    font-weight: 600;
}

#cleanupSubTabs QTabBar::tab:first {
    margin-left: 18px;
}

#cleanupSubTabs QTabBar::tab:selected {
    background-color: transparent;
    color: #0a84ff;
    border: none;
    border-bottom: 2px solid #0a84ff;
}

#cleanupSubTabs QTabBar::tab:hover:!selected {
    background-color: transparent;
    color: #f5f5f7;
    border: none;
}

QFrame#cleanupModelSummaryCard,
QFrame#meetingModelSummaryCard {
    background-color: #232325;
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QLabel#cleanupModelSummaryEyebrow,
QLabel#meetingModelSummaryEyebrow {
    color: #bf5af2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background-color: transparent;
    border: none;
}

QLabel#cleanupModelSummary,
QLabel#meetingModelSummary {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

QLabel#cleanupModelSummaryHint,
QLabel#meetingModelSummaryHint {
    color: #8e8e93;
    font-size: 11px;
    background-color: transparent;
    border: none;
}

QPushButton#cleanupModelManagerLink,
QPushButton#meetingModelManagerLink {
    color: #0a84ff;
    background-color: transparent;
    border: none;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 0;
    min-height: 0;
}

QPushButton#cleanupModelManagerLink:hover {
    color: #409cff;
    text-decoration: underline;
}

QPushButton#cleanupModelManagerLink:pressed {
    color: #0a84ff;
}

/* Fixed / Raw transcript version toggle */
QPushButton#transcriptVersionBtn {
    background-color: #2c2c2e;
    color: #8e8e93;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#transcriptVersionBtn:checked {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

QPushButton#transcriptVersionBtn:hover:!checked {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
}

/* Menu bar */
QMenuBar {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border-bottom: 1px solid #2c2c2e;
    font-size: 13px;
}

QMenuBar::item {
    padding: 8px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2c2c2e;
    border-radius: 4px;
}

/* Menu */
QMenu {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

/* Checkboxes */
QCheckBox {
    color: #f5f5f7;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #0a84ff;
    border: 1px solid #0a84ff;
    image: url(ui_qt/assets/check.svg); /* Placeholder for check icon */
}

/* Frame for grouping */
QFrame {
    border: none;
}

QFrame#cardFrame {
    background-color: #2c2c2e;
    border-radius: 16px;
    border: 1px solid #3a3a3c;
}

/* Status bar */
QStatusBar {
    background-color: #1c1c1e;
    color: #8e8e93;
    border-top: 1px solid #2c2c2e;
}

/* Custom card widget */
QWidget#card {
    background-color: #2c2c2e;
    border-radius: 16px;
    border: 1px solid #3a3a3c; /* Subtle border */
}

QWidget#controlPanel {
    background-color: #2c2c2e;
    border-radius: 16px;
    padding: 20px;
}

QWidget#header {
    background-color: transparent;
    border-bottom: 1px solid #2c2c2e;
}

/* Content Tab Bar */
QTabBar#contentTabBar::tab {
    background-color: transparent;
    color: #8e8e93;
    border: none;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
    margin-right: 8px;
}

QTabBar#contentTabBar::tab:selected {
    color: #0a84ff;
    border-bottom: 2px solid #0a84ff;
}

QTabBar#contentTabBar::tab:hover:!selected {
    color: #f5f5f7;
}

QTabBar#contentTabBar::tab:disabled {
    color: #48484a;
}

/* Recording indicator - pulsing effect handled in Python */
QTabBar#contentTabBar::tab:selected[recording="true"] {
    color: #ff453a;
    border-bottom-color: #ff453a;
}

/* Tooltips — elevated surface so they read against the dark window.
   The window is made translucent by RoundedTooltipFilter so the
   border-radius renders with transparent corners. */
QToolTip {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #545456;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Learned Rules: layered profile, composer, and library surfaces */
QFrame#cleanupRulesHero {
    background-color: #202b3a;
    border: 1px solid #2d4a69;
    border-radius: 16px;
}

QLabel#cleanupRulesEyebrow {
    color: #64b5ff;
    background-color: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QLabel#cleanupRulesTitle {
    color: #ffffff;
    background-color: transparent;
    font-size: 21px;
    font-weight: 700;
}

QLabel#cleanupRulesDescription {
    color: #aeb9c6;
    background-color: transparent;
    font-size: 12px;
}

QLabel#cleanupRulesHeroMark,
QLabel#cleanupRuleDialogMark {
    color: #ffffff;
    background-color: #0a84ff;
    border: 1px solid #3298ff;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 800;
}

QFrame#cleanupRulesCard {
    background-color: #242426;
    border: 1px solid #39393d;
    border-radius: 14px;
}

QLabel#cleanupRulesSectionTitle {
    color: #f5f5f7;
    background-color: transparent;
    font-size: 15px;
    font-weight: 700;
}

QLabel#cleanupRulesSectionHint,
QLabel#cleanupRulesInteractionHint {
    color: #8e8e93;
    background-color: transparent;
    font-size: 11px;
}

QLabel#cleanupRulesCount {
    color: #64b5ff;
    background-color: #17283a;
    border: 1px solid #294866;
    border-radius: 10px;
    padding: 3px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLineEdit#cleanupRuleInput {
    background-color: #1c1c1e;
    border: 1px solid #48484a;
    border-radius: 10px;
    padding: 9px 13px;
}

QLineEdit#cleanupRuleInput:hover {
    border-color: #636366;
}

QLineEdit#cleanupRuleInput:focus {
    background-color: #202022;
    border: 1px solid #0a84ff;
}

QPushButton#cleanupRuleDictateButton,
QPushButton#cleanupRuleEditButton,
QPushButton#cleanupRuleDeleteButton,
QPushButton#cleanupRuleAddButton {
    min-height: 44px;
    max-height: 44px;
    border-radius: 10px;
    padding: 0 15px;
    font-size: 12px;
}

QPushButton#cleanupRuleAddButton {
    color: #ffffff;
    background-color: #0a84ff;
    border: 1px solid #3298ff;
}

QPushButton#cleanupRuleAddButton:hover {
    background-color: #2492ff;
}

QPushButton#cleanupRuleAddButton:disabled {
    color: #636366;
    background-color: #2c2c2e;
    border-color: #3a3a3c;
}

QPushButton#cleanupRuleDeleteButton {
    min-height: 38px;
    max-height: 38px;
    color: #ff6961;
    background-color: transparent;
    border: 1px solid #5b3434;
}

QPushButton#cleanupRuleDeleteButton:hover {
    color: #ffffff;
    background-color: #a93636;
    border-color: #c34545;
}

QPushButton#cleanupRuleDeleteButton:disabled {
    color: #636366;
    background-color: transparent;
    border-color: #3a3a3c;
}

QPushButton#cleanupRuleEditButton {
    min-height: 38px;
    max-height: 38px;
}

QLabel#cleanupRuleStatus {
    color: #8e8e93;
    background-color: transparent;
    min-height: 14px;
    font-size: 11px;
}

QListWidget#cleanupRulesList {
    color: #f5f5f7;
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}

QListWidget#cleanupRulesList::item {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 9px;
    padding: 11px 13px;
}

QListWidget#cleanupRulesList::item:hover {
    background-color: #2c2c2e;
    border-color: #545456;
}

QListWidget#cleanupRulesList::item:selected {
    color: #ffffff;
    background-color: #173d63;
    border: 1px solid #0a84ff;
}

QLabel#cleanupRulesEmpty {
    color: #77777c;
    background-color: #1f1f21;
    border: 1px dashed #48484a;
    border-radius: 10px;
    padding: 24px;
    font-size: 12px;
}

/* Learned Rule review dialog */
QDialog#cleanupRuleDialog {
    background-color: #19191b;
}

QLabel#cleanupRuleDialogTitle {
    color: #ffffff;
    background-color: transparent;
    font-size: 18px;
    font-weight: 700;
}

QLabel#cleanupRuleDialogSubtitle,
QLabel#cleanupRuleDialogInfo {
    color: #9a9aa0;
    background-color: transparent;
    font-size: 12px;
}

QLabel#cleanupRuleOriginal {
    color: #d6d6da;
    background-color: #242426;
    border-left: 3px solid #0a84ff;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 12px;
}

QLabel#cleanupRuleNotice {
    color: #ffd08a;
    background-color: #332817;
    border: 1px solid #64491f;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 11px;
}

QFrame#cleanupRuleEditorCard {
    background-color: #242426;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QLabel#cleanupRuleEditorLabel {
    color: #64b5ff;
    background-color: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QTextEdit#cleanupRuleEditor {
    background-color: #1c1c1e;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 11px;
}

QTextEdit#cleanupRuleEditor:focus {
    border: 1px solid #0a84ff;
}

/* ── Meeting Mode ─────────────────────────────────────────────── */

QWidget#meetingModeTab,
QWidget#meetingModeContent {
    background-color: transparent;
}

QLabel#meetingModeSubtitle {
    color: #8e8e93;
    background-color: transparent;
}

QLabel#meetingStatusPill {
    background-color: #0a84ff;
    color: #ffffff;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    min-width: 64px;
}

QLabel#meetingElapsedLabel {
    color: #f5f5f7;
    font-size: 18px;
    font-weight: 600;
    font-family: "Segoe UI", "Helvetica Neue", monospace;
    background-color: transparent;
    padding: 0 4px;
}

QPushButton#meetingStartButton {
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    min-width: 220px;
}

QPushButton#meetingPauseButton,
QPushButton#meetingDashboardButton,
QPushButton#meetingGuestLinkButton {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
}

QPushButton#meetingEndButton {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
}

QCheckBox#meetingCloudCheckbox {
    color: #8e8e93;
    font-size: 13px;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox#meetingCloudCheckbox:hover {
    color: #f5f5f7;
}

QWidget#meetingFinalizationCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
}

QWidget#meetingFinalizationCard[finalizationTone="success"] {
    border: 1px solid #30d158;
}

QWidget#meetingFinalizationCard[finalizationTone="warning"] {
    border: 1px solid #ff9f0a;
}

QWidget#meetingFinalizationCard[finalizationTone="info"],
QWidget#meetingFinalizationCard[finalizationTone="neutral"] {
    border: 1px solid #0a84ff;
}

QLabel#meetingFinalizationTitle {
    color: #f5f5f7;
    background-color: transparent;
}

QLabel#meetingFinalizationMessage {
    color: #d1d1d6;
    font-size: 13px;
    background-color: transparent;
}

QProgressBar#meetingFinalizationProgress {
    background-color: #3a3a3c;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}

QProgressBar#meetingFinalizationProgress::chunk {
    background-color: #0a84ff;
    border-radius: 3px;
}

QPushButton#meetingFinalizationRetryButton,
QPushButton#meetingFinalizationDashboardButton {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
    min-width: 140px;
}

QDialog#meetingConsentDialog,
QDialog#meetingRecoveryDialog {
    background-color: #1c1c1e;
    color: #f5f5f7;
}

QLabel#consentBodyLabel {
    color: #d1d1d6;
    font-size: 13px;
    background-color: transparent;
    line-height: 1.4;
}

QFrame#meetingRecoveryRow {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QLabel#meetingRecoveryRowLabel {
    color: #f5f5f7;
    font-size: 13px;
    background-color: transparent;
}

QPushButton#meetingConsentNotNowButton,
QPushButton#meetingConsentEnableButton,
QPushButton#meetingRecoveryCloseButton,
QPushButton#meetingRecoveryFinalizeButton,
QPushButton#meetingRecoveryDiscardButton {
    padding: 8px 16px;
    font-size: 13px;
}

/* Meeting tab in Settings */
QLabel#meetingModelsStatus {
    color: #8e8e93;
    font-size: 12px;
}

QLabel#meetingBindWarning {
    background-color: #3a2a1c;
    border: 1px solid #ff9f0a;
    border-radius: 8px;
    color: #ffd60a;
    font-size: 12px;
    padding: 10px 12px;
}

QPushButton#meetingModelsRefreshButton {
    font-size: 13px;
}
